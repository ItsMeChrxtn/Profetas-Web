PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/profetas_farm?retryWrites=true&w=majority
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d
COOKIE_NAME=profetas_token
CLIENT_URL=http://localhost:5173
BREVO_API_KEY=your-brevo-api-key
BREVO_SENDER_EMAIL=noreply@yourdomain.com
BREVO_SENDER_NAME=Profetas Farm
LALAMOVE_API_KEY=your-lalamove-api-key
LALAMOVE_API_SECRET=your-lalamove-api-secret
LALAMOVE_ENV=sandbox
LALAMOVE_MARKET=PH_MNL
LALAMOVE_SERVICE_TYPE=MOTORCYCLE
LALAMOVE_SENDER_NAME=Profetas Farm
LALAMOVE_SENDER_PHONE=+639171234567
# Public HTTPS URL Lalamove pushes order status events to. Register it once with:
#   npm run register-webhook
LALAMOVE_WEBHOOK_URL=https://your-backend.onrender.com/api/webhooks/lalamove
